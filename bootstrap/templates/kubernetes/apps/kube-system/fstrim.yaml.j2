apiVersion: batch/v1
kind: CronJob
metadata:
  name: fstrim-var
  namespace: kube-system
spec:
  schedule: "0 4 * * 0"          # Sundays 04:00
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 2
  failedJobsHistoryLimit: 2
  jobTemplate:
    spec:
      backoffLimit: 1
      ttlSecondsAfterFinished: 86400
      template:
        spec:
          restartPolicy: Never
          nodeName: talos0
          tolerations:
            - operator: Exists
          containers:
            - name: fstrim
              image: debian:bookworm-slim
              command: ["sh", "-c", "fstrim -v /host-var"]
              securityContext:
                privileged: true
              volumeMounts:
                - name: var
                  mountPath: /host-var
          volumes:
            - name: var
              hostPath:
                path: /var
