---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: &app paperless-ngx
  namespace: flux-system
spec:
  dependsOn:
    - name: longhorn
    - name: external-secrets
    - name: crunchy-postgres-userinit-controller
    - name: dragonfly-cluster
  targetNamespace: cloud-apps
  commonMetadata:
    labels:
      app.kubernetes.io/name: *app
  path: ./kubernetes/apps/cloud-apps/paperless-ngx/app
  prune: true
  sourceRef:
    kind: GitRepository
    name: home-kubernetes
  wait: false
  interval: 30m
  timeout: 5m
