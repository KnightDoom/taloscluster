---
apiVersion: v1
kind: Secret
metadata:
  name: paperless-secret
stringData:
  PAPERLESS_SECRET_KEY: "#{ bootstrap_paperless.PAPERLESS_SECRET_KEY }#"
  PAPERLESS_SOCIALACCOUNT_PROVIDERS: >-
    #{ {
      "openid_connect": {
        "OAUTH_PKCE_ENABLED": true,
        "APPS": [{
          "provider_id": "authentik",
          "name": "authentik",
          "client_id": bootstrap_paperless.AUTHENTIK_CLIENT_ID,
          "secret": bootstrap_paperless.AUTHENTIK_CLIENT_SECRET,
          "settings": {
            "server_url": "https://sso2.${SECRET_DOMAIN}/application/o/paperless/.well-known/openid-configuration",
            "fetch_userinfo": true
          }
        }],
        "SCOPE": ["openid", "profile", "email"]
      }
    } | tojson }#
